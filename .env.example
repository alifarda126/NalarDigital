# Superadmin CMS credentials (/admin)
# Salin file ini menjadi .env.local lalu sesuaikan kredensial Anda.
# Gunakan tanda kutip ("...") terutama bila password mengandung karakter khusus seperti #.
# JANGAN pernah commit file .env.local ke Git!
ADMIN_USERNAME="superadmin"
ADMIN_PASSWORD="ganti-dengan-password-kuat-anda"
ADMIN_SESSION_SECRET="ganti-dengan-minimal-32-karakter-acak-untuk-signing-session"

# Opsional: aktifkan tulis disk pada mode tertentu (default otomatis aktif di dev lokal)
# ALLOW_LOCAL_CMS_WRITE=true
